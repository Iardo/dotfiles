layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="claude" focus=true {
        pane command="claude" {
            args "--dangerously-skip-permissions" "-n" "quake"
        }
    }

    tab name="shell" {
        pane
    }
}
